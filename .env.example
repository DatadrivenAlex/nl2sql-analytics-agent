# Copy to .env if you want local overrides. The process does not load .env automatically;
# export the variables yourself, or pass them through Docker Compose.

# SQLite file. Created and seeded on init-db, API startup, or the first ask.
NL2SQL_DB_PATH=data/analytics.sqlite

# auto: call the live model only when an API key is present, otherwise use the offline stub.
# stub: never call the network, even if a key is set.
# live: require an API key and send every question to the model.
NL2SQL_LLM_MODE=auto

# Optional OpenAI-compatible chat endpoint. Leave the key empty for the offline demo.
# NL2SQL_LLM_API_KEY wins over OPENAI_API_KEY when both are set.
NL2SQL_LLM_API_KEY=
# OPENAI_API_KEY=
NL2SQL_LLM_BASE_URL=https://api.openai.com/v1
NL2SQL_LLM_MODEL=gpt-4o-mini
NL2SQL_LLM_TIMEOUT_S=30

# Safety caps applied to every executed statement.
NL2SQL_MAX_ROWS=100
NL2SQL_QUERY_TIMEOUT_S=5
